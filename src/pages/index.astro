---
import AboutCard from "@/components/cards/AboutCard";
import ContactCard from "@/components/cards/ContactCard";
import EducationCard from "@/components/cards/EducationCard";
import ExperienceCard from "@/components/cards/ExperienceCard";
import ProjectsCard from "@/components/cards/ProjectsCard";
import SkillsCard from "@/components/cards/SkillsCard";
import { getDictionary, getLangFromHeader } from "@/i18n";
import Layout from "../layouts/Layout.astro";

const lang = getLangFromHeader(Astro.request.headers.get("accept-language"));
const dictionary = getDictionary(lang);
---

<Layout lang={lang}>
  <div
    class="bg-background flex min-h-screen flex-col px-4 py-5 font-sans text-slate-300 lg:h-screen lg:overflow-hidden lg:px-6 lg:py-6"
  >
    <main
      class="mx-auto grid h-full w-full max-w-[1400px] grid-cols-1 gap-4 lg:grid-cols-4 lg:grid-rows-[1.05fr_0.95fr_1fr]"
    >
      <AboutCard
        client:load
        className="lg:col-span-2 lg:row-span-2"
        content={dictionary.about}
      />
      <ExperienceCard
        client:load
        className="pb-4 lg:col-span-2 lg:row-span-1"
        content={dictionary.experience}
      />
      <SkillsCard
        client:load
        className="lg:col-span-2 lg:row-span-1"
        content={dictionary.skills}
      />
      <EducationCard
        client:load
        className="lg:col-span-1 lg:row-span-1"
        content={dictionary.education}
      />
      <ProjectsCard
        client:load
        className="lg:col-span-2 lg:row-span-1"
        content={dictionary.projects}
      />
      <ContactCard
        client:load
        className="lg:col-span-1 lg:row-span-1"
        content={dictionary.contact}
      />
    </main>
  </div>
</Layout>
