{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-05-26",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"secrets": {
		"required": [
			"TURNSTILE_SECRET_KEY",
			"RESEND_API_KEY",
			"RESEND_FROM_EMAIL",
			"CONTACT_EMAIL"
		]
	},
	"observability": {
		"enabled": true
	}
}
